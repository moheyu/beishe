<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wit.travel.mapper.UserRatingMapper">

    <select id="selectAverageScoreByScenicId" resultType="java.math.BigDecimal">
        SELECT AVG(score) FROM user_rating WHERE scenic_id = #{scenicId}
    </select>

    <select id="selectRatingCountByScenicId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user_rating WHERE scenic_id = #{scenicId}
    </select>

</mapper>
