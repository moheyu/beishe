<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wit.travel.mapper.UserMapper">

    <resultMap id="UserVOMap" type="com.wit.travel.vo.UserVO">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectNewUserList" resultMap="UserVOMap">
        SELECT id, username, nickname, avatar, role, status, create_time
        FROM user
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

</mapper>